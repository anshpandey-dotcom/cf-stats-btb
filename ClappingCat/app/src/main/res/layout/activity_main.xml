<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.clappingcat.ar.view.CatOverlayView
        android:id="@+id/cat"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status"
            android:gravity="center"
            android:maxWidth="320dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClap"
                    style="@style/ControlButton"
                    android:text="@string/mode_clap" />

                <Button
                    android:id="@+id/btnHandshake"
                    style="@style/ControlButton"
                    android:text="@string/mode_handshake" />

                <Button
                    android:id="@+id/btnSound"
                    style="@style/ControlButton"
                    android:text="@string/sound_on" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFace"
                    style="@style/ControlButton"
                    android:text="@string/face_on" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/ControlButton"
                    android:text="@string/reset" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
