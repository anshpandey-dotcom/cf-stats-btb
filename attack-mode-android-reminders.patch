+		t.Fatalf("pending = %d, err = %v", len(pending), err)
+	}
+
+	if err := st.MarkNotified(ctx, task.ID); err != nil {
+		t.Fatalf("mark notified: %v", err)
+	}
+	pending, _ = st.PendingReminders(ctx, "2026-10-22", "2026-10-24")
+	if len(pending) != 0 {
+		t.Fatalf("expected no pending reminders, got %d", len(pending))
+	}
+
+	newTime := "10:00"
+	if _, err := st.UpdateTask(ctx, task.ID, UpdateTaskInput{Time: &newTime}); err != nil {
+		t.Fatalf("update time: %v", err)
+	}
+	pending, _ = st.PendingReminders(ctx, "2026-10-22", "2026-10-24")
+	if len(pending) != 1 {
+		t.Fatalf("rescheduling should re-arm the reminder, got %d", len(pending))
+	}
+}
+
+func TestSubscriptionsAndSettings(t *testing.T) {
+	st := newTestStore(t)
+	ctx := context.Background()
+
+	sub := PushSubscription{Endpoint: "https://push.example/abc", P256dh: "k", Auth: "a", Timezone: "Asia/Kolkata"}
+	if err := st.SaveSubscription(ctx, sub); err != nil {
+		t.Fatalf("save: %v", err)
+	}
+	if err := st.SaveSubscription(ctx, sub); err != nil {
+		t.Fatalf("save twice: %v", err)
+	}
+	subs, _ := st.ListSubscriptions(ctx)
+	if len(subs) != 1 || subs[0].Timezone != "Asia/Kolkata" {
+		t.Fatalf("unexpected subscriptions: %+v", subs)
+	}
+	if err := st.SaveSubscription(ctx, PushSubscription{Endpoint: "http://x", P256dh: "k", Auth: "a"}); !errors.Is(err, ErrValidation) {
+		t.Fatalf("expected validation error, got %v", err)
+	}
+	_ = st.DeleteSubscription(ctx, sub.Endpoint)
+	if subs, _ = st.ListSubscriptions(ctx); len(subs) != 0 {
+		t.Fatalf("expected none, got %d", len(subs))
+	}
+
+	_ = st.SetSetting(ctx, "k", "v")
+	if v, _ := st.GetSetting(ctx, "k"); v != "v" {
+		t.Fatalf("setting = %q", v)
+	}
+}
